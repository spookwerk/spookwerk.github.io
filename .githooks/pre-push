#!/bin/sh
# Pre-push gate: every deployed page must pass the SEO/head-kit verifier.
# Activate once per clone: git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! python3 tools/verify-seo.py; then
    echo ""
    echo "PUSH BLOCKED: SEO verifier failed. Fix the pages listed above and retry."
    exit 1
fi
